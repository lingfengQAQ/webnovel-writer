{
  "name": "@linfengqaqtat/dsh-scriptor-companion",
  "version": "8.2.0",
  "description": "鲸鱼娘桌宠：DSH 窗口内的写作陪伴",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "assets/manifest.json",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "MEDIA.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest --root ../.. run packages/companion/tests",
    "pack-check": "node scripts/pack-check.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "react": "18.3.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-api-session-controller": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-connection": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-layout": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-session": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.0-rc.2",
    "@types/react": "18.3.12",
    "@types/node": "^22.0.0",
    "react": "18.3.1",
    "esbuild": "0.28.2",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": "^22.19.0 || ^24.0.0"
  },
  "license": "GPL-3.0-only",
  "publishConfig": {
    "access": "public",
    "tag": "latest",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lingfengQAQ/webnovel-writer.git",
    "directory": "packages/companion"
  }
}
