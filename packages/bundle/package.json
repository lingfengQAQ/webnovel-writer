    "lib/cli.js",
    "lib/preset.js",
    "lib/client.js",
    "skills/**/*",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "licenses/*.txt",
    "presets/*.yml"
