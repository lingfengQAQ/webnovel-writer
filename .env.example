# Webnovel Writer hosted platform
WEBNOVEL_PLATFORM_ENABLED=true
WEBNOVEL_DATA_DIR=/data
HOST=0.0.0.0
PORT=8765

# SubRouter management endpoint. The backend automatically appends /v1 for
# OpenAI-compatible model calls.
SUBROUTER_BASE_URL=http://subrouter.railway.internal:8080
#
# Public fallback:
# SUBROUTER_BASE_URL=https://api.subrouter.com
#
# Replace "subrouter" with the actual Railway service name if different.

# Set to true only if you terminate HTTPS before the app and want secure cookies.
WEBNOVEL_COOKIE_SECURE=false
